# Copier en .env.local et remplir. Ne jamais committer .env.local.
# Valeurs : tableau de bord Supabase > bouton « Connect » > App Frameworks > Next.js

# Publiques (visibles dans le navigateur, c'est normal : la RLS protège les données)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Serveur uniquement, plus tard (webhooks de paiement). Jamais de préfixe NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=

# Semaine 7
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
